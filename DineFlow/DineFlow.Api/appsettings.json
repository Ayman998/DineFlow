{
  "ConnectionStrings": {
    "DineFlow": "Server=localhost;Database=DineFlow;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "dineflow-api",
    "Audience": "dineflow",
    "SigningKey": "",
    "StaffTokenLifetime": "12:00:00"
  },
  "Qr": {
    "TokenKey": ""
  },
  "Guest": {
    "AppBaseUrl": "http://localhost:4200",
    "SessionLifetime": "04:00:00"
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:4300" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
