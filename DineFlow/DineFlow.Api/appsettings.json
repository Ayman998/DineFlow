{
  "ConnectionStrings": {
    "DineFlow": "Server=localhost;Database=DineFlow;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "dineflow-api",
    "Audience": "dineflow",
    "SigningKey": "",
    "StaffTokenLifetime": "12:00:00"
  },
  "Qr": {
    "TokenKey": ""
  },
  "Guest": {
    "AppBaseUrl": "http://localhost:4200",
    "SessionLifetime": "04:00:00"
  },
  "Payments": {
    "Provider": "sandbox",
    "TermsVersion": "2026-10",
    "TermsUrl": "https://dineflow.example/terms",
    "Sandbox": {
      "SecretKey": "",
      "AllowOutsideDevelopment": false
    }
  },
  "Email": {
    "From": "receipts@dineflow.local",
    "OutboxPath": "App_Data/outbox"
  },
  "WhatsApp": {
    "Provider": "outbox",
    "OutboxPath": "App_Data/whatsapp",
    "MetaApi": {
      "ApiVersion": "v21.0",
      "PhoneNumberId": "",
      "AccessToken": "",
      "TemplateName": "payment_alert",
      "TemplateLanguage": "en"
    }
  },
  "Pos": {
    "Foodics": {
      "BaseUrl": "https://api-sandbox.foodics.com/v5",
      "PaymentMethodId": "",
      "Timeout": "00:00:15"
    }
  },
  "Features": {
    "PaymentLinks": true,
    "WhatsAppAlerts": true,
    "EmailReports": true
  },
  "Seed": {
    "Enabled": false
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:4300" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
