<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5984942">
  <PropertyGroup>
    <!-- Starts both Angular apps: guest on http://localhost:4200, merchant on http://localhost:4300 -->
    <StartupCommand>npm start</StartupCommand>
    <!-- Regular builds don't run "ng build"; use Publish for a production build -->
    <BuildCommand>
    </BuildCommand>
    <ProductionBuildCommand>npm run build</ProductionBuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>
</Project>
