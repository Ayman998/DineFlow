{
  "name": "dineflow-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n guest,merchant -c cyan,yellow \"ng serve guest\" \"ng serve merchant\"",
    "start:guest": "ng serve guest",
    "start:merchant": "ng serve merchant",
    "build": "ng build guest && ng build merchant",
    "test": "ng test guest --watch=false && ng test merchant --watch=false",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^9.2.5",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
