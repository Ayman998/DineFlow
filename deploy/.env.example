# Copy to .env (never commit it) and fill in. Values with spaces don't need quotes.
# Generate keys with: openssl rand -base64 48

# ── Server ──────────────────────────────────────────────────────────────────────────────
# The guest app is served here and the merchant portal under /portal/. This name and www in front of
# it must point at this server before the first start (for the certificates).
GUEST_DOMAIN=hello-zen.com
ACME_EMAIL=ops@hello-zen.com
# Image tag to run: latest, or a release such as 1.0.0. IMAGE_PREFIX defaults to ghcr.io/ayman998/hellozen.
TAG=latest

# SQL Server's sa password: 12+ characters with upper and lower case, a digit and a symbol.
DB_SA_PASSWORD=

# ── API (ASP.NET Core reads Section__Key as Section:Key) ───────────────────────────────
# Where printed QR codes and payment links point. Changing it later breaks printed codes.
Guest__AppBaseUrl=https://hello-zen.com
Cors__Origins__0=https://hello-zen.com

Jwt__SigningKey=
# Signs every QR code. Never change it once codes are printed.
Qr__TokenKey=

# Payments: Mastercard Gateway (MPGS) from your acquirer. Start on the test gateway with TEST… credentials.
Payments__Provider=mastercard
# Guests accept these before paying. Publish the page before going live: until then this address shows the guest home.
# Guests accept the guest app's own /terms page; set Payments__TermsUrl only to use another page.
# The company behind helloZen, shown on /terms, /privacy, /refunds and /contact (acquirers check them).
Legal__LegalName=
Legal__Address=
Legal__Email=
Legal__Phone=
Payments__Mastercard__GatewayUrl=https://test-gateway.mastercard.com
Payments__Mastercard__MerchantId=
Payments__Mastercard__ApiPassword=
Payments__Mastercard__WebhookSecret=
Payments__Mastercard__NotificationUrl=https://hello-zen.com/v1/webhooks/payments/mastercard

# E-mail (receipts, payment links, reports) through any SMTP server: Microsoft 365, Google Workspace, SendGrid…
Email__Provider=smtp
Email__From=helloZen <receipts@hello-zen.com>
Email__Smtp__Host=smtp.office365.com
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=
Email__Smtp__Password=

# WhatsApp payment alerts: 'outbox' writes them to files; 'meta' sends through the WhatsApp Cloud API.
WhatsApp__Provider=outbox
# WhatsApp__MetaApi__PhoneNumberId=
# WhatsApp__MetaApi__AccessToken=

# Features you can switch off for the pilot.
# Features__PaymentLinks=true
# Features__WhatsAppAlerts=true
# Features__EmailReports=true
