# One site for both apps: the guest app on the domain itself and the merchant portal under /portal/,
# plus www in front. Caddy gets and renews their Let's Encrypt certificates by itself once the
# domains' DNS points at this server and ports 80 and 443 are open.
{
	email {$ACME_EMAIL}
}

# The API's paths: REST, SignalR (WebSockets), menu photos, health checks, and the sandbox's test
# checkout page for demo environments.
(api) {
	@api path /v1/* /hubs/* /media/* /health/* /sandbox/*
	handle @api {
		reverse_proxy api:8080
	}
}

# One Angular app's files, from the folder given as the argument.
(spa) {
	root * {args[0]}
	# Angular's js and css file names change with every build, so they can be cached for good.
	# Everything else (index.html under any route, icons) is revalidated, or phones keep loading
	# the previous release. Headers are matched before try_files rewrites deep links.
	@hashed path *.js *.css
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path *.js *.css
	header @other Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

{$GUEST_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	import api
	# The merchant app is built with base href /portal/, so its routes and files sit under it.
	redir /portal /portal/
	handle_path /portal/* {
		import spa /srv/merchant
	}
	handle {
		import spa /srv/guest
	}
}

# People type www.hello-zen.com too; send them to the one address the QR codes use.
www.{$GUEST_DOMAIN} {
	redir https://{$GUEST_DOMAIN}{uri} permanent
}
