<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes helloZen to MonsterASP (site103877, https://app.hello-zen.com) with Web Deploy: in Visual
  Studio, right-click HelloZen.Api > Publish > MonsterASP. It builds both Angular apps into wwwroot and
  sets ASPNETCORE_ENVIRONMENT=MonsterAsp, so appsettings.MonsterAsp.json applies. The password isn't
  stored here; Visual Studio keeps it in MonsterASP.pubxml.user, which git ignores.
  See deploy/monsterasp/README.md.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <MSDeployServiceURL>https://site103877.siteasp.net:8172/msdeploy.axd?site=site103877</MSDeployServiceURL>
    <DeployIisAppPath>site103877</DeployIisAppPath>
    <UserName>site103877</UserName>
    <_SavePWD>true</_SavePWD>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net8.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <SiteUrlToLaunchAfterPublish>https://app.hello-zen.com</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- App_Data on the server holds uploaded photos, the Data Protection keys and the logs: keep it. -->
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <!-- Takes the site offline while files are copied, or IIS keeps the DLLs locked. -->
    <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
    <EnvironmentName>MonsterAsp</EnvironmentName>
    <IncludeWebApps>true</IncludeWebApps>
  </PropertyGroup>
</Project>
