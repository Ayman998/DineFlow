{
  "WebApps": {
    "Enabled": true
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Guest": {
    "AppBaseUrl": "https://app.hello-zen.com"
  },
  "Cors": {
    "Origins": [ "https://app.hello-zen.com", "https://hello-zen.com" ]
  },
  "Payments": {
    "Provider": "mastercard",
    "Mastercard": {
      "NotificationUrl": "https://app.hello-zen.com/v1/webhooks/payments/mastercard"
    }
  },
  "Email": {
    "Provider": "smtp",
    "From": "helloZen <receipts@hello-zen.com>",
    "Smtp": {
      "Host": "site103877.siteasp.net",
      "Port": 25,
      "Security": "None"
    }
  },
  "Legal": {
    "LegalName": "",
    "Address": "",
    "Email": "",
    "Phone": "",
    "RegistrationNumber": ""
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/hellozen-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
